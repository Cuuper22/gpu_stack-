{
  "schema": "gpu-stack.e001-semantic-consistency-scenario.v1",
  "experiment_id": "E001-SC1",
  "scenario_id": "observable-semantic-slack-controller-v1",
  "frozen_at": "2026-07-13",
  "research_question": "Can a controller that sees only current and past training-system state switch among exact synchronization, exact forward recovery, one-step-delayed updates, and periodic local updates while preserving held-out learning, reducing inter-site communication, and finishing equal canonical work sooner under changing bandwidth, power availability, and failures?",
  "hypothesis": "A compact observable state exposes usable semantic slack: on untouched stress families, observable_adaptive will remain learning-noninferior to the calibration-selected best fixed policy while using at most one fifth of its inter-site payload bytes and at most nine tenths of its modeled completion time.",
  "novelty_boundary": "The reviewed recent sources study individual delay, local-update, recovery, reconfiguration, or simulation mechanisms. None of them evaluates a transferable online boundary among exact recovery, delayed updates, and local updates under joint network, power, and failure variation. This is evidence of an open intersection, not proof of universal priority.",
  "claim_boundary": {
    "stage": "measured_small_model_plus_virtual_datacenter",
    "can_resolve": [
      "small-model held-out NLL under actual consistency-mode transitions",
      "exact token, sample, update-age, lineage, replay, and inter-site payload accounting",
      "modeled completion-time ranking within the frozen bandwidth, compute-rate, and failure schedules",
      "whether the observable controller beats the calibration-selected fixed policy on untouched stress families",
      "where the controller abstains because its calibrated state support is exceeded"
    ],
    "cannot_resolve": [
      "frontier-model convergence transfer",
      "real multi-datacenter WAN tails or correlated regional failures",
      "facility or grid energy",
      "Muon, GASLoC, PipeDream-2BW, ReCoVer, or DynaTrain implementation equivalence",
      "a universal optimal consistency controller"
    ]
  },
